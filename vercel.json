{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/v1/status-rede",
      "destination": "/api/v1/status-rede"
    },
    {
      "source": "/api/status-rede",
      "destination": "/api/status-rede"
    },
    {
      "source": "/api/v1/:match*",
      "destination": "/api/:match*"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, PUT, DELETE" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-api-key, api-key, X-Requested-With, Accept" }
      ]
    }
  ]
}
